                "updated_at": {
                    "type": "string"
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
        "district-friends_internal_models.FriendshipStatus": {
            "type": "string",
            "enum": [
                "pending",
                "accepted",
                "declined"
            ],
            "x-enum-varnames": [
                "StatusPending",
                "StatusAccepted",
                "StatusDeclined"
            ]
        },
        "district-friends_internal_models.Message": {
            "type": "object",
